generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  SENT_TO_KITCHEN
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum KotStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  ESEWA
  KHALTI
  BANK_TRANSFER
  OTHER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum PurchaseStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  WASTE
  DAMAGE
  RETURN
}

enum LedgerEntryType {
  CREDIT_SALE
  PAYMENT
  ADJUSTMENT
  REFUND
}

model Tenant {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(150)
  slug String @unique @db.VarChar(80)
  isActive Boolean @default(true)
  memberships TenantMembership[]
  sessions Session[]
  settings RestaurantSettings?
  categories Category[]
  menuItems MenuItem[]
  recipes Recipe[]
  recipeItems RecipeItem[]
  tables RestaurantTable[]
  customers Customer[]
  orders Order[]
  orderItems OrderItem[]
  kots Kot[]
  kotItems KotItem[]
  payments Payment[]
  refunds Refund[]
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  suppliers Supplier[]
  purchases Purchase[]
  purchaseItems PurchaseItem[]
  expenses Expense[]
  ledgerEntries CustomerLedgerEntry[]
  audits AuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  email String @unique @db.VarChar(255)
  phone String? @db.VarChar(30)
  passwordHash String
  isActive Boolean @default(true)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships TenantMembership[]
  sessions Session[]
  orders Order[] @relation("OrderCreator")
  cancelledOrders Order[] @relation("OrderCanceller")
  payments Payment[]
  refundsProcessed Refund[]
  audits AuditLog[]
  ledgerEntries CustomerLedgerEntry[]
  stockMovements StockMovement[]
  purchases Purchase[]
  expenses Expense[]
}

model TenantMembership {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid
  isActive Boolean @default(true)
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  role Role @relation(fields:[roleId], references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, userId])
  @@index([userId, isActive])
  @@index([tenantId, isActive])
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tenantId String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Role {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(50)
  description String?
  permissions RolePermission[]
  memberships TenantMembership[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id String @id @default(uuid()) @db.Uuid
  key String @unique @db.VarChar(100)
  description String?
  roles RolePermission[]
  createdAt DateTime @default(now())
}

model RolePermission {
  roleId String @db.Uuid
  permissionId String @db.Uuid
  role Role @relation(fields:[roleId], references:[id], onDelete: Cascade)
  permission Permission @relation(fields:[permissionId], references:[id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model RestaurantSettings {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @unique @db.Uuid
  businessName String @db.VarChar(150)
  address String?
  logo String?
  phone String?
  email String?
  currency String @default("NPR")
  timezone String @default("Asia/Kathmandu")
  taxEnabled Boolean @default(false)
  taxRate Decimal @default(0) @db.Decimal(5,2)
  taxInclusive Boolean @default(false)
  receiptFooter String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
}

model Category {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String @db.VarChar(100)
  description String?
  displayOrder Int @default(0)
  isActive Boolean @default(true)
  menuItems MenuItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model MenuItem {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  categoryId String @db.Uuid
  name String @db.VarChar(150)
  description String?
  price Decimal @db.Decimal(12,2)
  inventoryItemId String? @db.Uuid
  imageUrl String?
  isActive Boolean @default(true)
  category Category @relation(fields:[categoryId], references:[id])
  inventoryItem InventoryItem? @relation(fields:[inventoryItemId], references:[id], onDelete: SetNull)
  orderItems OrderItem[]
  recipes Recipe[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  @@index([tenantId, categoryId, isActive])
  @@unique([tenantId, inventoryItemId])
}

model Recipe {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  menuItemId String @db.Uuid
  name String @db.VarChar(150)
  isActive Boolean @default(true)
  menuItem MenuItem @relation(fields:[menuItemId], references:[id])
  items RecipeItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
}

model RecipeItem {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  recipeId String @db.Uuid
  inventoryItemId String @db.Uuid
  quantity Decimal @db.Decimal(14,3)
  unit String @db.VarChar(20)
  recipe Recipe @relation(fields:[recipeId], references:[id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields:[inventoryItemId], references:[id])
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
}

model RestaurantTable {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tableNumber String @db.VarChar(30)
  capacity Int
  status TableStatus @default(AVAILABLE)
  isActive Boolean @default(true)
  orders Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  @@unique([tenantId, tableNumber])
  @@index([tenantId, isActive, status])
}

model Customer {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String @db.VarChar(150)
  phone String? @db.VarChar(30)
  email String?
  address String?
  notes String?
  isActive Boolean @default(true)
  orders Order[]
  ledgerEntries CustomerLedgerEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  @@index([tenantId, phone])
}

model Order {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  orderNumber BigInt
  orderType OrderType
  tableId String? @db.Uuid
  customerId String? @db.Uuid
  createdBy String @db.Uuid
  status OrderStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID)
  subtotal Decimal @db.Decimal(12,2)
  discountAmount Decimal @default(0) @db.Decimal(12,2)
  taxAmount Decimal @default(0) @db.Decimal(12,2)
  totalAmount Decimal @db.Decimal(12,2)
  notes String?
  completedAt DateTime?
  cancelledAt DateTime?
  cancelledBy String? @db.Uuid
  cancellationReason String?
  table RestaurantTable? @relation(fields:[tableId], references:[id])
  customer Customer? @relation(fields:[customerId], references:[id])
  creator User @relation("OrderCreator", fields:[createdBy], references:[id])
  canceller User? @relation("OrderCanceller", fields:[cancelledBy], references:[id])
  items OrderItem[]
  kots Kot[]
  payments Payment[]
  refunds Refund[]
  ledgerEntries CustomerLedgerEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  @@unique([tenantId, orderNumber])
  @@index([tenantId, createdAt, status, paymentStatus])
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  orderId String @db.Uuid
  menuItemId String @db.Uuid
  itemName String @db.VarChar(150)
  quantity Decimal @db.Decimal(10,3)
  unitPrice Decimal @db.Decimal(12,2)
  discountAmount Decimal @default(0) @db.Decimal(12,2)
  totalAmount Decimal @db.Decimal(12,2)
  notes String?
  order Order @relation(fields:[orderId], references:[id], onDelete: Cascade)
  menuItem MenuItem @relation(fields:[menuItemId], references:[id])
  kotItems KotItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
}

model Kot {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  kotNumber BigInt
  orderId String @db.Uuid
  status KotStatus @default(PENDING)
  createdBy String @db.Uuid
  startedAt DateTime?
  readyAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  order Order @relation(fields:[orderId], references:[id])
  items KotItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  @@unique([tenantId, kotNumber])
  @@index([tenantId, status, createdAt])
}

model KotItem {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  kotId String @db.Uuid
  orderItemId String @db.Uuid
  quantity Decimal @db.Decimal(10,3)
  notes String?
  status KotStatus @default(PENDING)
  kot Kot @relation(fields:[kotId], references:[id], onDelete: Cascade)
  orderItem OrderItem @relation(fields:[orderItemId], references:[id])
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  orderId String @db.Uuid
  method PaymentMethod
  amount Decimal @db.Decimal(12,2)
  status TransactionStatus @default(COMPLETED)
  referenceNumber String? @db.VarChar(150)
  idempotencyKey String? @unique @db.VarChar(150)
  receivedBy String @db.Uuid
  notes String?
  paidAt DateTime?
  order Order @relation(fields:[orderId], references:[id])
  receiver User @relation(fields:[receivedBy], references:[id])
  refunds Refund[]
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  @@index([tenantId, orderId, status])
}

model Refund {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  paymentId String @db.Uuid
  orderId String @db.Uuid
  amount Decimal @db.Decimal(12,2)
  reason String
  approvedBy String @db.Uuid
  processedBy String @db.Uuid
  payment Payment @relation(fields:[paymentId], references:[id])
  order Order @relation(fields:[orderId], references:[id])
  processor User @relation(fields:[processedBy], references:[id])
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
}

model InventoryItem {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String @db.VarChar(150)
  sku String? @db.VarChar(100)
  unit String @db.VarChar(20)
  currentQuantity Decimal @default(0) @db.Decimal(14,3)
  minimumQuantity Decimal @default(0) @db.Decimal(14,3)
  costPrice Decimal @default(0) @db.Decimal(12,2)
  isActive Boolean @default(true)
  recipeItems RecipeItem[]
  sellableMenuItems MenuItem[]
  purchaseItems PurchaseItem[]
  movements StockMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  @@unique([tenantId, sku])
  @@index([tenantId, name, isActive])
}

model StockMovement {
  id String @id @default(uuid())
  tenantId String @db.Uuid
  inventoryItemId String @db.Uuid
  type StockMovementType
  quantity Decimal @db.Decimal(14,3)
  previousQuantity Decimal @db.Decimal(14,3)
  newQuantity Decimal @db.Decimal(14,3)
  referenceType String? @db.VarChar(50)
  referenceId String? @db.Uuid
  reason String?
  createdBy String @db.Uuid
  inventoryItem InventoryItem @relation(fields:[inventoryItemId], references:[id])
  creator User @relation(fields:[createdBy], references:[id])
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  @@index([tenantId, inventoryItemId, createdAt])
}

model Supplier {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String @db.VarChar(150)
  phone String?
  email String?
  address String?
  taxNumber String?
  notes String?
  isActive Boolean @default(true)
  purchases Purchase[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  @@index([tenantId, isActive])
}

model Purchase {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  purchaseNumber BigInt
  supplierId String @db.Uuid
  subtotal Decimal @db.Decimal(12,2)
  taxAmount Decimal @default(0) @db.Decimal(12,2)
  totalAmount Decimal @db.Decimal(12,2)
  status PurchaseStatus @default(DRAFT)
  notes String?
  createdBy String @db.Uuid
  supplier Supplier @relation(fields:[supplierId], references:[id])
  creator User @relation(fields:[createdBy], references:[id])
  items PurchaseItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  @@unique([tenantId, purchaseNumber])
  @@index([tenantId, status, createdAt])
}

model PurchaseItem {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  purchaseId String @db.Uuid
  inventoryItemId String @db.Uuid
  quantity Decimal @db.Decimal(14,3)
  unitCost Decimal @db.Decimal(12,2)
  totalCost Decimal @db.Decimal(12,2)
  purchase Purchase @relation(fields:[purchaseId], references:[id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields:[inventoryItemId], references:[id])
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
}

model Expense {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  category String @db.VarChar(100)
  description String
  amount Decimal @db.Decimal(12,2)
  paymentMethod String @db.VarChar(50)
  expenseDate DateTime @db.Date
  createdBy String @db.Uuid
  isCancelled Boolean @default(false)
  cancelledBy String? @db.Uuid
  cancellationReason String?
  creator User @relation(fields:[createdBy], references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  @@index([tenantId, expenseDate])
}

model CustomerLedgerEntry {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  customerId String @db.Uuid
  orderId String? @db.Uuid
  type LedgerEntryType
  debit Decimal @default(0) @db.Decimal(12,2)
  credit Decimal @default(0) @db.Decimal(12,2)
  reference String
  description String?
  createdBy String @db.Uuid
  customer Customer @relation(fields:[customerId], references:[id])
  order Order? @relation(fields:[orderId], references:[id])
  creator User @relation(fields:[createdBy], references:[id])
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  @@index([tenantId, customerId, createdAt])
}

model AuditLog {
  id String @id @default(uuid())
  tenantId String @db.Uuid
  userId String? @db.Uuid
  action String @db.VarChar(100)
  entityType String @db.VarChar(100)
  entityId String @db.Uuid
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  user User? @relation(fields:[userId], references:[id])
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  @@index([tenantId, entityType, entityId, createdAt])
}
