generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  SENT_TO_KITCHEN
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum BillStatus {
  OPEN
  CLOSED
}

enum KotStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  ESEWA
  KHALTI
  BANK_TRANSFER
  OTHER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum PurchaseStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  WASTE
  DAMAGE
  RETURN
}

enum LedgerEntryType {
  CREDIT_SALE
  PAYMENT
  ADJUSTMENT
  REFUND
}

model Tenant {
  id             String                @id @default(uuid()) @db.Char(36)
  name           String                @db.VarChar(150)
  slug           String                @unique @db.VarChar(80)
  isActive       Boolean               @default(true)
  memberships    TenantMembership[]
  sessions       Session[]
  settings       RestaurantSettings?
  categories     Category[]
  menuItems      MenuItem[]
  recipes        Recipe[]
  recipeItems    RecipeItem[]
  tables         RestaurantTable[]
  customers      Customer[]
  orders         Order[]
  bills          Bill[]
  orderItems     OrderItem[]
  kots           Kot[]
  kotItems       KotItem[]
  payments       Payment[]
  refunds        Refund[]
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  suppliers      Supplier[]
  purchases      Purchase[]
  purchaseItems  PurchaseItem[]
  expenses       Expense[]
  ledgerEntries  CustomerLedgerEntry[]
  audits         AuditLog[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model User {
  id               String                @id @default(uuid()) @db.Char(36)
  name             String                @db.VarChar(120)
  email            String                @unique @db.VarChar(255)
  phone            String?               @db.VarChar(30)
  passwordHash     String                @db.Text
  isActive         Boolean               @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  memberships      TenantMembership[]
  sessions         Session[]
  orders           Order[]               @relation("OrderCreator")
  cancelledOrders  Order[]               @relation("OrderCanceller")
  payments         Payment[]
  refundsProcessed Refund[]
  audits           AuditLog[]
  ledgerEntries    CustomerLedgerEntry[]
  stockMovements   StockMovement[]
  purchases        Purchase[]
  expenses         Expense[]
}

model TenantMembership {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @db.Char(36)
  userId    String   @db.Char(36)
  roleId    String   @db.Char(36)
  isActive  Boolean  @default(true)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([userId, isActive])
  @@index([tenantId, isActive])
}

model Session {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  tenantId  String   @db.Char(36)
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Role {
  id          String             @id @default(uuid()) @db.Char(36)
  name        String             @unique @db.VarChar(50)
  description String?            @db.Text
  permissions RolePermission[]
  memberships TenantMembership[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Permission {
  id          String           @id @default(uuid()) @db.Char(36)
  key         String           @unique @db.VarChar(100)
  description String?          @db.Text
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  roleId       String     @db.Char(36)
  permissionId String     @db.Char(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RestaurantSettings {
  id            String   @id @default(uuid()) @db.Char(36)
  tenantId      String   @unique @db.Char(36)
  businessName  String   @db.VarChar(150)
  address       String?  @db.Text
  logo          String?  @db.MediumText
  phone         String?  @db.Text
  email         String?  @db.Text
  /// Optional VAT/PAN registration number, printed on bills when present.
  taxNumber     String?  @db.VarChar(50)
  currency      String   @default("NPR") @db.VarChar(10)
  timezone      String   @default("Asia/Kathmandu") @db.VarChar(50)
  taxEnabled    Boolean  @default(false)
  taxRate       Decimal  @default(0) @db.Decimal(5, 2)
  taxInclusive  Boolean  @default(false)
  receiptFooter String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Category {
  id           String     @id @default(uuid()) @db.Char(36)
  tenantId     String     @db.Char(36)
  name         String     @db.VarChar(100)
  description  String?    @db.Text
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  menuItems    MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model MenuItem {
  id              String         @id @default(uuid()) @db.Char(36)
  tenantId        String         @db.Char(36)
  categoryId      String         @db.Char(36)
  name            String         @db.VarChar(150)
  description     String?        @db.Text
  price           Decimal        @db.Decimal(12, 2)
  inventoryItemId String?        @db.Char(36)
  imageUrl        String?        @db.Text
  isActive        Boolean        @default(true)
  category        Category       @relation(fields: [categoryId], references: [id])
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  orderItems      OrderItem[]
  recipes         Recipe[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, inventoryItemId])
  @@index([inventoryItemId])
  @@index([tenantId, categoryId, isActive])
}

model Recipe {
  id         String       @id @default(uuid()) @db.Char(36)
  tenantId   String       @db.Char(36)
  menuItemId String       @db.Char(36)
  name       String       @db.VarChar(150)
  isActive   Boolean      @default(true)
  menuItem   MenuItem     @relation(fields: [menuItemId], references: [id])
  items      RecipeItem[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model RecipeItem {
  id              String        @id @default(uuid()) @db.Char(36)
  tenantId        String        @db.Char(36)
  recipeId        String        @db.Char(36)
  inventoryItemId String        @db.Char(36)
  quantity        Decimal       @db.Decimal(14, 3)
  unit            String        @db.VarChar(20)
  recipe          Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model RestaurantTable {
  id          String      @id @default(uuid()) @db.Char(36)
  tenantId    String      @db.Char(36)
  tableNumber String      @db.VarChar(30)
  capacity    Int
  status      TableStatus @default(AVAILABLE)
  isActive    Boolean     @default(true)
  orders      Order[]
  bills       Bill[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tableNumber])
  @@index([tenantId, isActive, status])
}

model Bill {
  id         String           @id @default(uuid()) @db.Char(36)
  tenantId   String           @db.Char(36)
  tableId    String?          @db.Char(36)
  billNumber BigInt           @unique @default(autoincrement())
  status     BillStatus       @default(OPEN)
  customerName String?        @db.VarChar(150)
  printedAt  DateTime?
  closedAt   DateTime?
  tableClosedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table      RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  orders     Order[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, tableId, status])
  @@index([tenantId, createdAt])
}

model Customer {
  id            String                @id @default(uuid()) @db.Char(36)
  tenantId      String                @db.Char(36)
  name          String                @db.VarChar(150)
  phone         String?               @db.VarChar(30)
  email         String?               @db.Text
  address       String?               @db.Text
  notes         String?               @db.Text
  isActive      Boolean               @default(true)
  orders        Order[]
  ledgerEntries CustomerLedgerEntry[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, phone])
}

model Order {
  id                 String                @id @default(uuid()) @db.Char(36)
  tenantId           String                @db.Char(36)
  orderNumber        BigInt
  orderType          OrderType
  tableId            String?               @db.Char(36)
  billId             String                @db.Char(36)
  customerId         String?               @db.Char(36)
  createdBy          String                @db.Char(36)
  status             OrderStatus           @default(DRAFT)
  paymentStatus      PaymentStatus         @default(UNPAID)
  subtotal           Decimal               @db.Decimal(12, 2)
  discountAmount     Decimal               @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal               @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal               @db.Decimal(12, 2)
  notes              String?               @db.Text
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelledBy        String?               @db.Char(36)
  cancellationReason String?               @db.Text
  table              RestaurantTable?      @relation(fields: [tableId], references: [id])
  bill               Bill                  @relation(fields: [billId], references: [id], onDelete: Cascade)
  customer           Customer?             @relation(fields: [customerId], references: [id])
  creator            User                  @relation("OrderCreator", fields: [createdBy], references: [id])
  canceller          User?                 @relation("OrderCanceller", fields: [cancelledBy], references: [id])
  items              OrderItem[]
  kots               Kot[]
  payments           Payment[]
  refunds            Refund[]
  ledgerEntries      CustomerLedgerEntry[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orderNumber])
  @@index([tenantId, createdAt, status, paymentStatus])
  @@index([billId])
}

model OrderItem {
  id             String    @id @default(uuid()) @db.Char(36)
  tenantId       String    @db.Char(36)
  orderId        String    @db.Char(36)
  menuItemId     String    @db.Char(36)
  itemName       String    @db.VarChar(150)
  quantity       Decimal   @db.Decimal(10, 3)
  unitPrice      Decimal   @db.Decimal(12, 2)
  discountAmount Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal   @db.Decimal(12, 2)
  notes          String?   @db.Text
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem       MenuItem  @relation(fields: [menuItemId], references: [id])
  kotItems       KotItem[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Kot {
  id          String    @id @default(uuid()) @db.Char(36)
  tenantId    String    @db.Char(36)
  kotNumber   BigInt
  orderId     String    @db.Char(36)
  status      KotStatus @default(PENDING)
  createdBy   String    @db.Char(36)
  startedAt   DateTime?
  readyAt     DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  order       Order     @relation(fields: [orderId], references: [id])
  items       KotItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kotNumber])
  @@index([tenantId, status, createdAt])
}

model KotItem {
  id          String    @id @default(uuid()) @db.Char(36)
  tenantId    String    @db.Char(36)
  kotId       String    @db.Char(36)
  orderItemId String    @db.Char(36)
  quantity    Decimal   @db.Decimal(10, 3)
  notes       String?   @db.Text
  status      KotStatus @default(PENDING)
  kot         Kot       @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String            @id @default(uuid()) @db.Char(36)
  tenantId        String            @db.Char(36)
  orderId         String            @db.Char(36)
  method          PaymentMethod
  amount          Decimal           @db.Decimal(12, 2)
  status          TransactionStatus @default(COMPLETED)
  referenceNumber String?           @db.VarChar(150)
  idempotencyKey  String?           @unique @db.VarChar(150)
  receivedBy      String            @db.Char(36)
  notes           String?           @db.Text
  paidAt          DateTime?
  order           Order             @relation(fields: [orderId], references: [id])
  receiver        User              @relation(fields: [receivedBy], references: [id])
  refunds         Refund[]
  createdAt       DateTime          @default(now())
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId, status])
}

model Refund {
  id          String   @id @default(uuid()) @db.Char(36)
  tenantId    String   @db.Char(36)
  paymentId   String   @db.Char(36)
  orderId     String   @db.Char(36)
  amount      Decimal  @db.Decimal(12, 2)
  reason      String   @db.Text
  approvedBy  String   @db.Char(36)
  processedBy String   @db.Char(36)
  payment     Payment  @relation(fields: [paymentId], references: [id])
  order       Order    @relation(fields: [orderId], references: [id])
  processor   User     @relation(fields: [processedBy], references: [id])
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id                String          @id @default(uuid()) @db.Char(36)
  tenantId          String          @db.Char(36)
  name              String          @db.VarChar(150)
  sku               String?         @db.VarChar(100)
  unit              String          @db.VarChar(20)
  currentQuantity   Decimal         @default(0) @db.Decimal(14, 3)
  minimumQuantity   Decimal         @default(0) @db.Decimal(14, 3)
  costPrice         Decimal         @default(0) @db.Decimal(12, 2)
  isActive          Boolean         @default(true)
  recipeItems       RecipeItem[]
  sellableMenuItems MenuItem[]
  purchaseItems     PurchaseItem[]
  movements         StockMovement[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@index([tenantId, name, isActive])
}

model InventorySkuSequence {
  value BigInt @id @default(autoincrement())
}

model StockMovement {
  id               String            @id @default(uuid()) @db.Char(36)
  tenantId         String            @db.Char(36)
  inventoryItemId  String            @db.Char(36)
  type             StockMovementType
  quantity         Decimal           @db.Decimal(14, 3)
  previousQuantity Decimal           @db.Decimal(14, 3)
  newQuantity      Decimal           @db.Decimal(14, 3)
  referenceType    String?           @db.VarChar(50)
  referenceId      String?           @db.Char(36)
  reason           String?           @db.Text
  createdBy        String            @db.Char(36)
  inventoryItem    InventoryItem     @relation(fields: [inventoryItemId], references: [id])
  creator          User              @relation(fields: [createdBy], references: [id])
  createdAt        DateTime          @default(now())
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, inventoryItemId, createdAt])
}

model Supplier {
  id        String     @id @default(uuid()) @db.Char(36)
  tenantId  String     @db.Char(36)
  name      String     @db.VarChar(150)
  phone     String?    @db.Text
  email     String?    @db.Text
  address   String?    @db.Text
  taxNumber String?    @db.Text
  notes     String?    @db.Text
  isActive  Boolean    @default(true)
  purchases Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
}

model Purchase {
  id             String         @id @default(uuid()) @db.Char(36)
  tenantId       String         @db.Char(36)
  purchaseNumber BigInt
  supplierId     String         @db.Char(36)
  subtotal       Decimal        @db.Decimal(12, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal        @db.Decimal(12, 2)
  status         PurchaseStatus @default(DRAFT)
  notes          String?        @db.Text
  createdBy      String         @db.Char(36)
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  creator        User           @relation(fields: [createdBy], references: [id])
  items          PurchaseItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, purchaseNumber])
  @@index([tenantId, status, createdAt])
}

model PurchaseItem {
  id              String        @id @default(uuid()) @db.Char(36)
  tenantId        String        @db.Char(36)
  purchaseId      String        @db.Char(36)
  inventoryItemId String        @db.Char(36)
  quantity        Decimal       @db.Decimal(14, 3)
  unitCost        Decimal       @db.Decimal(12, 2)
  totalCost       Decimal       @db.Decimal(12, 2)
  purchase        Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Expense {
  id                 String   @id @default(uuid()) @db.Char(36)
  tenantId           String   @db.Char(36)
  category           String   @db.VarChar(100)
  description        String   @db.Text
  amount             Decimal  @db.Decimal(12, 2)
  paymentMethod      String   @db.VarChar(50)
  expenseDate        DateTime @db.Date
  createdBy          String   @db.Char(36)
  isCancelled        Boolean  @default(false)
  cancelledBy        String?  @db.Char(36)
  cancellationReason String?  @db.Text
  creator            User     @relation(fields: [createdBy], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, expenseDate])
}

model CustomerLedgerEntry {
  id          String          @id @default(uuid()) @db.Char(36)
  tenantId    String          @db.Char(36)
  customerId  String          @db.Char(36)
  orderId     String?         @db.Char(36)
  type        LedgerEntryType
  debit       Decimal         @default(0) @db.Decimal(12, 2)
  credit      Decimal         @default(0) @db.Decimal(12, 2)
  reference   String          @db.Text
  description String?         @db.Text
  createdBy   String          @db.Char(36)
  customer    Customer        @relation(fields: [customerId], references: [id])
  order       Order?          @relation(fields: [orderId], references: [id])
  creator     User            @relation(fields: [createdBy], references: [id])
  createdAt   DateTime        @default(now())
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  tenantId   String   @db.Char(36)
  userId     String?  @db.Char(36)
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String   @db.Char(36)
  oldValues  Json?
  newValues  Json?
  ipAddress  String?  @db.Text
  userAgent  String?  @db.Text
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId, createdAt])
}
