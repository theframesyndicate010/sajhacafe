NODE_ENV=development
PORT=3000
# Supabase pooled connection for runtime
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:6543/postgres?pgbouncer=true&connection_limit=1
# Supabase direct connection for Prisma migrations
DIRECT_DATABASE_URL=postgresql://postgres:password@db-host:5432/postgres
SESSION_COOKIE_NAME=cafe_session
SESSION_TTL_SECONDS=28800
FRONTEND_ORIGIN=http://localhost:3001
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000
SEED_ADMIN_PASSWORD=change-me-before-production
