NODE_ENV=development
PORT=3000
# MySQL connection used by the application at runtime
DATABASE_URL="mysql://cafe_user:change-me@127.0.0.1:3306/sajhacafe?connection_limit=5"
# MySQL direct connection used by Prisma migrations
DIRECT_DATABASE_URL="mysql://cafe_user:change-me@127.0.0.1:3306/sajhacafe"
SESSION_COOKIE_NAME=cafe_session
# How long a login stays valid. Shorter values are honoured, but anything above
# 54000 (15 hours) is capped there by the server.
SESSION_TTL_SECONDS=28800
FRONTEND_ORIGIN=http://localhost:3001
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000
